# ---- Required. Server refuses to boot without these (server.js) ----
# MongoDB connection string. For production use a MongoDB Atlas cluster.
# For local development you can instead run `npm run dev:memory`, which
# starts an ephemeral in-memory MongoDB and injects this for you.
MONGO_URI="mongodb+srv://username:password@cluster.mongodb.net/kisansetu"

# Signing key for auth cookies. Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the value from any tutorial or commit it to git.
JWT_SECRET="generate_a_long_random_value"

# ---- Core config ----
NODE_ENV="development"
PORT=5000
# Comma-separated list of allowed browser origins (CORS + Socket.IO).
FRONTEND_ORIGIN="http://localhost:5173"

# ---- External services ----
# data.gov.in mandi price feed. Free key from https://data.gov.in
API_KEY="your_data_gov_in_api_key"

# Google Gemini, used for the crop analysis endpoints. Optional —
# /api/ai/* returns an error if unset, the rest of the app works.
GEMINI_API_KEY=your_gemini_api_key

# Shared secret for the maintenance price-refresh route
# (POST /api/store-crop-prices, sent as the x-admin-secret header).
ADMIN_SECRET=your_admin_task_secret

# ---- SMS / OTP ----
# "dev" logs OTP codes to the console instead of sending real SMS.
# Set to "msg91" and fill the keys below to send real messages.
SMS_PROVIDER=dev
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=

# ---- Optional ----
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
